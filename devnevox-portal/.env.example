# ─────────────────────────────────────────────────────────────
# devnevoX Portal — environment
# Copy to `.env` and fill in. Only DATABASE_URL + NEXTAUTH_SECRET
# are required to run; Stripe/Google are optional add-ons.
# ─────────────────────────────────────────────────────────────

# PostgreSQL (required)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/devnevox?schema=public"

# NextAuth (required) — generate: `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-long-random-string"
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Google OAuth (optional — Google button only appears when set)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Stripe TEST mode (optional — checkout/billing enable when set)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# File storage (optional — used by the Files feature in production)
# AWS S3
AWS_REGION=""
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_S3_BUCKET=""
# or Cloudinary
CLOUDINARY_URL=""
